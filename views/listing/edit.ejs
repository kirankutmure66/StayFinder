<% layout("layouts/boilerplates")%>
<body>
    <h2>Edit Listing</h2>
    <div class="row">
        <div class="col-8 offset-2">
        <form method="post" action="/listing/<%=listing._id%>?_method=put"
           novalidate class="row g-3 needs-validation"
           enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label" >Title</label>
              <input required name="listing[title]" type="text" class="form-control" value="<%=listing.title%>">      
              <div class="valid-feedback" >Good Title</div>
            </div>

       
            <div class="mb-3">
            <label for="descripton" class="form-label" >Description</label>
              <input required name="listing[description]" type="text" class="form-control" value="<%=listing.description%>">
              <div class="invalid-feedback" >Provide Description</div>
            </div>
        <div class="row">
           
                 <div class="mb-3 col-4" >
                 <label for="Price" class="form-label" >Price</label>
                 <input required name="listing[price]"  class="form-control" value="<%=listing.price%>">
                 <div class="invalid-feedback" >Price shoud be Valid</div>
                </div>
                 <div class="mb-3 col-8" >
                  <label for="location" class="form-label" >Location</label>
                 <input required name="listing[location]" type="text" class="form-control" value="<%=listing.location%>">
                 <div class="invalid-feedback" >location shoud be Valid</div>
                </div>
           
        </div>
      
         <div class="mb-3">
            <label for="country" class="form-label" >country</label>
              <input required name="listing[country]" type="text" class="form-control" value="<%=listing.country%>">
              <div class="invalid-feedback" >country shoud be Valid</div>
            </div>

        <div class="mb-3">
           <p>original image</p>
           <img src="<%=originalurl%>" alt="">
        </div>

        <div class="mb-3">
            <label for="image" class="form-label" >Upload New Image</label>
              <input name="listing[image]" type="file" 
              class="form-control" >
        </div>
       
     <br>
        <button type="submit" class="addbtn col-1 offset-5 mb-2 mt-1">Edit</button>
        
    </form>
    </div>
    <script src="/js/script.js"></script>
</div>
</body>

